# The gateway runs on the host; use the Compose external listener.
KAFKA_BROKERS=localhost:9092
HTTP_ADDRESS=:8080
ROUTES_FILE=config/routes.yaml
MAX_BODY_BYTES=1048576
MAX_EVENTS=100
BATCH_MODE=atomic
DELIVERY_MODE=sync
ASYNC_QUEUE_SIZE=1000
ASYNC_WORKERS=4
SHUTDOWN_TIMEOUT_SECONDS=10
KAFKA_WRITE_TIMEOUT_SECONDS=10
